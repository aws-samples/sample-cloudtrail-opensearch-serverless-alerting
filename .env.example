# Copy to .env (git-ignored) and fill in your values. The deploy commands in README.md read these.
#   cp .env.example .env

# Existing S3 bucket where your CloudTrail trail delivers logs
CLOUDTRAIL_BUCKET=amzn-s3-demo-bucket

# Optional: IAM user or role ARN that gets read access to the collection (leave empty to skip)
ADMIN_PRINCIPAL_ARN=arn:aws:iam::111122223333:role/Admin

# Optional: email address subscribed to alerts (you confirm the subscription from your inbox).
# Leave empty to create the topic without a subscription.
ALERT_EMAIL=ops@example.com
